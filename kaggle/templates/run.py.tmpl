"""Kaggle job {{RUN_ID}} (generated by scripts/kaggle/make_job.py; do not edit by hand).

task={{TASK}} config={{CONFIG}} seed={{SEED}} commit={{COMMIT}}
Code comes from the private Kaggle Dataset {{CODE_DATASET}}; the job stops if its COMMIT.txt
differs from the commit above (PROTOCOL §9.1). Outputs go to /kaggle/working/out/ with the
same layout as results/ in the repository.
"""

import json
import os
import subprocess
import sys
import time
from pathlib import Path

RUN_ID = "{{RUN_ID}}"
TASK = "{{TASK}}"
CONFIG = "{{CONFIG}}"
SEED = "{{SEED}}"
COMMIT = "{{COMMIT}}"
EXTRA_ARGS = {{EXTRA_ARGS}}  # smoke-run limits or --trainable; empty for real runs
INPUT = Path("/kaggle/input")
OUT = Path("/kaggle/working/out")


def find_one(name, kind):
    hits = sorted(p for p in INPUT.rglob(name) if (p.is_dir() if kind == "dir" else p.is_file()))
    if len(hits) != 1:
        sys.exit(f"STOP: expected exactly one {name} under {INPUT}, found {hits}")
    return hits[0]


def sha256(path):
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        while block := fh.read(1 << 20):
            h.update(block)
    return h.hexdigest()


def data_root(cfg):
    """A folder holding TrainDataset/ and TestDataset/ as discover() expects.

    Kaggle unzips uploaded archives one level deeper (TrainDataset/TrainDataset/...), so the real
    folders are located by their content and linked side by side under /kaggle/working/data.
    Falls back to extracting the original zips (sha-checked) if no unzipped copy is mounted.
    """
    d = cfg["data"]
    train = [p for p in INPUT.rglob("TrainDataset") if (p / d["train_image_subdir"]).is_dir()]
    test = [p for p in INPUT.rglob("TestDataset") if (p / d["test_folders"]["etis"]).is_dir()]
    if len(train) == 1 and len(test) == 1:
        root = Path("/kaggle/working/data_links")
        root.mkdir(parents=True, exist_ok=True)
        for name, target in (("TrainDataset", train[0]), ("TestDataset", test[0])):
            if not (root / name).exists():
                (root / name).symlink_to(target, target_is_directory=True)
        return root
    import zipfile
    dest = Path("/kaggle/working/data")
    for name, expected in cfg["data"]["zip_sha256"].items():
        z = find_one(name, "file")
        if sha256(z) != expected:
            sys.exit(f"STOP: {name} sha256 differs from configs/base.yaml")
        with zipfile.ZipFile(z) as zf:
            zf.extractall(dest, [m for m in zf.namelist() if not m.startswith("__MACOSX")])
    return dest


def checkpoint(cfg):
    """Download the official SAM ViT-B checkpoint once and check its sha256 (PROTOCOL §5.1)."""
    import urllib.request
    m = cfg["model"]
    path = Path("/kaggle/working/ckpt") / m["checkpoint"]
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        urllib.request.urlretrieve(m["checkpoint_url"], path)
    got = sha256(path)
    if m.get("checkpoint_sha256") and got != m["checkpoint_sha256"]:
        sys.exit(f"STOP: checkpoint sha256 {got} differs from configs/base.yaml")
    return path, got


commit_file = find_one("COMMIT.txt", "file")
code_dir = commit_file.parent
bundled = commit_file.read_text().strip()
print(f"run_id={RUN_ID} expected commit={COMMIT} bundled commit={bundled}", flush=True)
if bundled != COMMIT:
    sys.exit("STOP: code dataset commit differs from the job commit")

subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "--no-deps",
                       "-r", str(code_dir / "requirements-kaggle.txt")])
sys.path.insert(0, str(code_dir / "src"))
# Child processes (run_task.py, audit_dataset.py) need the package path too.
SUB_ENV = {**os.environ, "PYTHONPATH": str(code_dir / "src") + os.pathsep + os.environ.get("PYTHONPATH", "")}
os.chdir(code_dir)  # configs/ and data/ are read relative to the bundle

from samrel.config import load_config  # noqa: E402
from samrel.constants import DATASETS  # noqa: E402
from samrel.data import discover  # noqa: E402
from samrel.manifest import environment, new_manifest, write_json  # noqa: E402

CFG = load_config(CONFIG)

OUT.mkdir(parents=True, exist_ok=True)
started = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
ENV = environment()
write_json(ENV, OUT / "logs" / "environment" / f"{RUN_ID}.json")
lock_file = code_dir / "configs" / "env_kaggle.lock.json"
if TASK != "env" and lock_file.exists():
    locked = json.loads(lock_file.read_text())["versions"]
    diff = {k: (v, ENV.get(k)) for k, v in locked.items() if ENV.get(k) != v}
    if diff:
        sys.exit(f"STOP: Kaggle image differs from configs/env_kaggle.lock.json: {diff}")


def file_sha(rel):
    p = code_dir / rel
    return sha256(p) if p.exists() else None


from samrel.config import config_sha256  # noqa: E402

HASHES = {"config_sha256": config_sha256(CFG), "prompts_sha256": file_sha(CFG["data"]["prompts_file"]),
          "val_split_sha256": file_sha(CFG["data"]["val_split_file"]),
          "excluded_sha256": file_sha(CFG["data"]["excluded_file"]),
          "checkpoint_sha256": CFG["model"].get("checkpoint_sha256")}
status = "failed"
try:
    if TASK == "env":
        # Smoke job: environment (to lock configs/env_kaggle.lock.json), data counts, checkpoint
        # sha256. Uses no model output, so it informs no experimental decision.
        root = data_root(CFG)
        recs = discover(root, CFG["data"])
        counts = {ds: sum(r.dataset == ds and r.image_path is not None for r in recs) for ds in DATASETS}
        ok = all(counts[ds] == n for ds, (_, n) in DATASETS.items())
        ckpt, ckpt_sha = checkpoint(CFG)
        write_json({"counts": counts, "counts_ok": ok, "checkpoint": ckpt.name, "checkpoint_sha256": ckpt_sha,
                    "checkpoint_bytes": ckpt.stat().st_size}, OUT / "logs" / "smoke" / f"{RUN_ID}.json")
        if not ok:
            sys.exit(f"STOP: image counts differ from PROTOCOL §1.1: {counts}")
    elif TASK == "audit":
        root = data_root(CFG)
        subprocess.check_call([sys.executable, str(code_dir / "scripts/data/audit_dataset.py"),
                               "--data-root", str(root), "--out-dir", str(OUT / "data_checks"),
                               "--splits-dir", str(OUT / "splits")], env=SUB_ENV)
    elif TASK in ("infer", "train"):
        root = data_root(CFG)
        ckpt, ckpt_sha = checkpoint(CFG)
        print(f"checkpoint sha256 {ckpt_sha}", flush=True)
        cmd = [sys.executable, str(code_dir / "scripts/run/run_task.py"), "--task", TASK, "--config", CONFIG,
               "--seed", SEED, "--run-id", RUN_ID, "--commit", COMMIT, "--data-root", str(root),
               "--checkpoint", str(ckpt), "--out", str(OUT), "--work", "/kaggle/working/work"]
        cmd += EXTRA_ARGS
        subprocess.check_call(cmd, env=SUB_ENV)
    elif TASK == "perturb":
        # PROTOCOL §14: existing weights (mounted kernel outputs), oracle + perturbed boxes, pp00 check
        root = data_root(CFG)
        ckpt, ckpt_sha = checkpoint(CFG)
        print(f"checkpoint sha256 {ckpt_sha}", flush=True)
        cmd = [sys.executable, str(code_dir / "scripts/run/run_perturb.py"), "--commit", COMMIT,
               "--stamp", RUN_ID.rsplit("_", 1)[1], "--data-root", str(root), "--checkpoint", str(ckpt),
               "--out", str(OUT), "--search-root", str(INPUT), "--check-p0"]
        subprocess.check_call(cmd + EXTRA_ARGS, env=SUB_ENV)
    elif TASK in ("ensemble", "benchmark"):
        root = data_root(CFG)
        cmd = [sys.executable, str(code_dir / "scripts/run/run_post.py"), "--task", TASK, "--run-id", RUN_ID,
               "--commit", COMMIT, "--data-root", str(root), "--out", str(OUT), "--search-root", str(INPUT)]
        if TASK == "benchmark":
            ckpt, _ = checkpoint(CFG)
            cmd += ["--checkpoint", str(ckpt)]
        subprocess.check_call(cmd + EXTRA_ARGS, env=SUB_ENV)
    else:
        raise NotImplementedError(f"unknown task {TASK!r}")
    status = "ok"
finally:
    write_json(new_manifest(run_id=RUN_ID, config=CONFIG, seed=SEED, commit=COMMIT, commit_dirty=False, **HASHES,
                            kaggle_account="{{ACCOUNT}}", kernel_slug="{{KAGGLE_USER}}/{{KERNEL_SLUG}}",
                            started_utc=started, status=status,
                            finished_utc=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())),
               OUT / "logs" / "manifests" / f"{RUN_ID}.json")
    print(json.dumps({"run_id": RUN_ID, "status": status}), flush=True)
